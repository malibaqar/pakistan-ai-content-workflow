{
  "name": "Pakistan AI \u2014 collect and draft (free)",
  "nodes": [
    {
      "id": "research-schedule",
      "name": "Research schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8,18 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "collect-and-draft",
      "name": "Collect and draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "http://worker:8787/research",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 1500000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Editorial worker"
        }
      }
    }
  ],
  "connections": {
    "Research schedule": {
      "main": [
        [
          {
            "node": "Collect and draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Karachi"
  },
  "pinData": {},
  "tags": []
}
